{
  "name": "filmscatalog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "node --require ./scripts/drizzle-kit-os-workaround.cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:security": "tsx scripts/apply-security.ts",
    "db:security:verify": "tsx scripts/verify-security.ts",
    "test:e2e:local": "tsx scripts/verify-auth-favorites-flow.ts",
    "test:cache-worker:local": "node --require ./scripts/drizzle-kit-os-workaround.cjs --import tsx scripts/verify-cache-worker-flow.ts",
    "worker": "node --env-file=.env.local --import tsx src/worker/index.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "verify:worker-build": "node scripts/verify-worker-build.mjs",
    "verify:compose": "node scripts/verify-compose.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "better-auth": "^1.7.1",
    "bullmq": "^6.2.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
