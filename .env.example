# Docker Compose reads .env (not .env.local). Replace every placeholder before
# use. The standard stack uses the external PostgreSQL URLs below; the local-db
# overlay ignores them and builds private postgres:5432 URLs from POSTGRES_PASSWORD.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://app_user:replace-with-external-db-password@db.example.com:5432/filmscatalog?sslmode=require
DIRECT_URL=postgresql://app_user:replace-with-external-db-password@db.example.com:5432/filmscatalog?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
REDIS_URL=redis://redis:6379
CACHE_TTL_LIST=60
CACHE_TTL_ITEM=300
TRENDING_TOP_N=10
TRENDING_ITEMS_TTL_SECONDS=900
TRENDING_REBUILD_CRON="*/5 * * * *"
TRUST_PROXY_FOR_RATE_LIMIT=false
POSTGRES_PASSWORD=replace-with-local-postgres-password
